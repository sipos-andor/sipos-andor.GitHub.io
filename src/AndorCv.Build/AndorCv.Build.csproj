<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The CV's build program: the resume engine with the operandor theme and the PDF writer. A console on the Web SDK,
    so publishing lays out the theme's and the design system's static assets under wwwroot/_content, which the
    engine copies to the site. It runs no server.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The program has no components of its own, so no scoped CSS bundle may reach the site. -->
    <ScopedCssEnabled>false</ScopedCssEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sipos.Resume.Generation" />
    <PackageReference Include="Sipos.Resume.Theme.Operandor" />
    <PackageReference Include="Sipos.Resume.Documents.Pdf" />
  </ItemGroup>

</Project>
